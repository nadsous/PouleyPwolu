 Le depfile liste tous les fichiers copiés : ninja recopie dès que l'un change.
 """
+import json
 import os
 import shutil
 import sys
+import zlib
 
 # Sous-dossiers prévus dans chrome/installer/mini_installer/chrome.release.
 ALLOWED = {'', 'icons', 'sidebar', 'content', 'pages', 'lib', 'data', 'core',
            'nadspdf', 'nadspdf/icons', 'nadspdf/models'}
 
 
+def stamp_version(dst, rel, files):
+    """Ajoute à la version une empreinte du contenu (0.2.0 → 0.2.0.<n>).
+
+    Chromium ne réinstalle le service worker d'une extension intégrée que si sa
+    version change : sans empreinte, une mise à jour du navigateur garderait
+    l'ancien script de fond. La version affichée reste dans « version_name ».
+    """
+    crc = 0
+    for name in sorted(files):
+        with open(os.path.join(dst, name), 'rb') as f:
+            crc = zlib.crc32(name.encode('utf-8') + b'|' + f.read(), crc)
+    path = os.path.join(dst, rel, 'manifest.json')
+    with open(path, encoding='utf-8') as f:
+        manifest = json.load(f)
+    base = manifest['version']
+    manifest.setdefault('version_name', base)
+    manifest['version'] = '%s.%d' % ('.'.join(base.split('.')[:3]), crc % 65535)
+    with open(path, 'w', encoding='utf-8') as f:
+        json.dump(manifest, f, ensure_ascii=False, indent=2)
+
+
 def main():
