+void FinishElectronSwitch() {
+  base::FilePath dir = MigrationDir();
+  if (dir.empty() || !base::PathExists(dir.Append(L"manifest.json"))) {
+    return;  // Pas de passage depuis Electron (cas normal).
+  }
+  const base::FilePath done = dir.Append(L"electron-retire");
+  if (base::PathExists(done)) {
+    return;
+  }
+  base::FilePath exe;
+  base::FilePath local;
+  if (!base::PathService::Get(base::FILE_EXE, &exe) ||
+      !base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local)) {
+    return;
+  }
+  // Le choix « navigateur par défaut » de Windows désigne ces ProgIds : on les
+  // garde, ils ouvrent maintenant ce navigateur.
+  const std::wstring quoted = L"\"" + exe.value() + L"\"";
+  const std::wstring icon = exe.value() + L",0";
+  auto set = [](const std::wstring& path, const wchar_t* name,
+                const std::wstring& value) {
+    base::win::RegKey key;
+    if (key.Open(HKEY_CURRENT_USER, path.c_str(), KEY_SET_VALUE) ==
+        ERROR_SUCCESS) {
+      key.WriteValue(name, value.c_str());
+    }
+  };
+  for (const wchar_t* id : {L"PouleyPwoluHTML", L"PouleyPwoluURL"}) {
+    const std::wstring base_path = std::wstring(L"Software\\Classes\\") + id;
+    set(base_path + L"\\shell\\open\\command", L"",
+        quoted + L" --single-argument %1");
+    set(base_path + L"\\DefaultIcon", L"", icon);
+    set(base_path + L"\\Application", L"ApplicationIcon", icon);
+  }
+  const std::wstring client =
+      L"Software\\Clients\\StartMenuInternet\\PouleyPwolu";
+  set(client + L"\\shell\\open\\command", L"", quoted);
+  set(client + L"\\DefaultIcon", L"", icon);
+  set(client + L"\\Capabilities", L"ApplicationIcon", icon);
+
+  // --updated : l'ancienne version part sans effacer ces inscriptions.
+  const base::FilePath uninstaller = local.Append(L"Programs")
+                                         .Append(L"PouleyPwolu")
+                                         .Append(L"Uninstall PouleyPwolu.exe");
+  if (base::PathExists(uninstaller)) {
+    base::CommandLine cmd(uninstaller);
+    cmd.AppendArg("/S");
+    cmd.AppendArg("--updated");
+    base::LaunchOptions options;
+    options.start_hidden = true;
+    base::LaunchProcess(cmd, options);
+  }
+  base::WriteFile(done, "");
+}
