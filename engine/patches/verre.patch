+bool SetWindowMaterial(const std::string& material) {
+  const WindowMaterial value = material == "acrylic" ? WindowMaterial::kAcrylic
+                               : material == "mica"  ? WindowMaterial::kMica
+                                                     : WindowMaterial::kNone;
+#if BUILDFLAG(IS_WIN)
+  const bool changed = value != GetWindowMaterial();
+  SetWindowMaterialValue(value);
+  if (changed) {
+    // Les couleurs du cadre et du panneau latéral dépendent de la matière.
+    ui::ColorProviderManager::Get().ResetColorProviderCache();
+  }
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [changed](BrowserWindowInterface* browser) {
+        BrowserView* browser_view =
+            BrowserView::GetBrowserViewForBrowser(browser);
+        views::Widget* widget =
+            browser_view ? browser_view->GetWidget() : nullptr;
+        if (!widget || !browser_view->GetIsNormalType()) {
+          return true;
+        }
+        ApplyWindowMaterial(views::HWNDForWidget(widget));
+        if (changed) {
+          widget->FrameTypeChanged();
+          widget->ThemeChanged();
+          widget->GetRootView()->SchedulePaint();
+        }
+        return true;
+      });
+  return true;
+#else
+  return value == WindowMaterial::kNone;
+#endif
+}
