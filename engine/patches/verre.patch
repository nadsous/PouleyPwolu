@@ -0,0 +1,34 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_POULEY_MATERIAL_H_
+#define CHROME_BROWSER_UI_COLOR_POULEY_MATERIAL_H_
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif
+
+// PouleyPwolu : matière de la fenêtre (réglage « Transparence de la fenêtre »).
+// Avec Mica ou l'acrylique (Windows 11), le cadre, la bande du haut et le panneau
+// latéral ne sont plus peints : le verre de Windows apparaît derrière la barre
+// PouleyPwolu, dont la page est elle-même translucide.
+namespace pouley {
+
+enum class WindowMaterial { kNone = 0, kMica = 1, kAcrylic = 2 };
+
+// Défini dans chrome/browser/ui/color/chrome_color_mixers.cc.
+WindowMaterial GetWindowMaterial();
+void SetWindowMaterialValue(WindowMaterial material);
+
+#if BUILDFLAG(IS_WIN)
+// Pose le verre de Windows (DWM) sur une fenêtre du navigateur. Défini dans
+// chrome/browser/ui/views/frame/browser_desktop_window_tree_host_win.cc.
+void ApplyWindowMaterial(HWND hwnd);
+#endif
+
+}  // namespace pouley
+
+#endif  // CHROME_BROWSER_UI_COLOR_POULEY_MATERIAL_H_
