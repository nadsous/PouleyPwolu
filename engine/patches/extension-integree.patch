--- /dev/null
+++ b/chrome/browser/resources/pouley/BUILD.gn
@@ -0,0 +1,20 @@
+# Copyright 2026 PouleyPwolu
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# Extension intégrée PouleyPwolu : copiée dans resources/pouley à côté de
+# chrome.dll, puis chargée comme composant (component_loader.cc).
+# Ses sources (engine/extension du dépôt PouleyPwolu) sont copiées dans
+# extension/ par engine/rebrand.py.
+action("extension") {
+  script = "copy_extension.py"
+  inputs = [ "extension/manifest.json" ]
+  outputs = [ "$root_out_dir/resources/pouley/manifest.json" ]
+  depfile = "$target_gen_dir/extension.d"
+  args = [
+    rebase_path("extension", root_build_dir),
+    rebase_path("$root_out_dir/resources/pouley", root_build_dir),
+    rebase_path(depfile, root_build_dir),
+    rebase_path(outputs[0], root_build_dir),
+  ]
+}
diff --git a/chrome/browser/resources/pouley/copy_extension.py b/chrome/browser/resources/pouley/copy_extension.py
new file mode 100644
index 0000000000..e0ba6a065b
--- /dev/null
+++ b/chrome/browser/resources/pouley/copy_extension.py
@@ -0,0 +1,38 @@
+# Copyright 2026 PouleyPwolu
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Copie l'extension intégrée PouleyPwolu dans le dossier de sortie.
+
+copy_extension.py <source> <destination> <depfile> <sortie principale>
+Le depfile liste tous les fichiers copiés : ninja recopie dès que l'un change.
+"""
+import os
+import shutil
+import sys
+
+# Sous-dossiers prévus dans chrome/installer/mini_installer/chrome.release.
+ALLOWED = {'', 'icons', 'sidebar', 'content', 'pages', 'lib', 'data', 'core'}
+
+
+def main():
+    src, dst, depfile, output = sys.argv[1:5]
+    if os.path.isdir(dst):
+        shutil.rmtree(dst)
+    inputs = []
+    for root, _dirs, files in os.walk(src):
+        rel = os.path.relpath(root, src)
+        rel = '' if rel == '.' else rel.replace(os.sep, '/')
+        if files and rel not in ALLOWED:
+            sys.exit('copy_extension.py : sous-dossier %r absent de chrome.release' % rel)
+        os.makedirs(os.path.join(dst, rel), exist_ok=True)
+        for f in files:
+            shutil.copyfile(os.path.join(root, f), os.path.join(dst, rel, f))
+            inputs.append(os.path.join(root, f).replace(os.sep, '/'))
+    # Format Makefile : une espace dans un chemin s'écrit « \ ».
+    os.makedirs(os.path.dirname(depfile), exist_ok=True)
+    with open(depfile, 'w', encoding='utf-8') as d:
+        d.write('%s: %s\n' % (output.replace(os.sep, '/'), ' '.join(i.replace(' ', '\\ ') for i in inputs)))
+
+
+if __name__ == '__main__':
+    main()
