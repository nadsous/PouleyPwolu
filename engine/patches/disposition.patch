+ExtensionFunction::ResponseAction
+PouleyPrivateGetExtensionBadgesFunction::Run() {
+  auto params = api::pouley_private::GetExtensionBadges::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  BrowserWindowInterface* browser = BrowserFor(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  std::vector<api::pouley_private::ExtensionBadge> result;
+  for (auto& badge : pouley::GetExtensionBadges(browser)) {
+    api::pouley_private::ExtensionBadge out;
+    out.extension_id = badge.extension_id;
+    out.text = badge.text;
+    out.color = base::StringPrintf("#%02X%02X%02X", SkColorGetR(badge.color),
+                                   SkColorGetG(badge.color),
+                                   SkColorGetB(badge.color));
+    result.push_back(std::move(out));
+  }
+  return RespondNow(ArgumentList(
+      api::pouley_private::GetExtensionBadges::Results::Create(result)));
+}
