+ExtensionFunction::ResponseAction PouleyPrivateSystemMediaFunction::Run() {
+  auto params = api::pouley_private::SystemMedia::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  // Le script est livré avec l'extension intégrée (data/system-media.ps1).
+  const std::string script = extension()
+                                 ->path()
+                                 .AppendASCII("data")
+                                 .AppendASCII("system-media.ps1")
+                                 .AsUTF8Unsafe();
+  // Une seule séquence : le processus PowerShell répond à une commande à la fois.
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}));
+  (*runner)->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&pouley::RunSystemMedia, script, params->command),
+      base::BindOnce(&PouleyPrivateSystemMediaFunction::OnResult, this));
+  return RespondLater();
+}
+
+void PouleyPrivateSystemMediaFunction::OnResult(std::string result) {
+  Respond(WithArguments(std::move(result)));
+}
