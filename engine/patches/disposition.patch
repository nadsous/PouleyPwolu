+bool FocusPage(BrowserWindowInterface* browser) {
+  content::WebContents* contents =
+      browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  contents->Focus();
+  return true;
+}
