+namespace {
+// Une seule bulle d'aperçu à la fois ; le délégué doit survivre à la bulle.
+struct Preview {
+  std::unique_ptr<views::Widget> widget;
+  std::unique_ptr<views::BubbleDialogDelegate> delegate;
+};
+Preview& CurrentPreview() {
+  static base::NoDestructor<Preview> preview;
+  return *preview;
+}
+void ClosePreview() {
+  CurrentPreview().widget.reset();
+  CurrentPreview().delegate.reset();
+}
+}  // namespace
+
+bool ShowPreview(BrowserWindowInterface* browser,
+                 const GURL& url,
+                 const gfx::Rect& anchor) {
+  ClosePreview();
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || !url.is_valid()) {
+    return false;
+  }
+  const bool right = browser_view->side_panel() &&
+                     browser_view->side_panel()->IsRightAligned();
+  auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(AnchorFor(browser_view, anchor)),
+      right ? views::BubbleBorder::RIGHT_TOP : views::BubbleBorder::LEFT_TOP,
+      views::BubbleBorder::DIALOG_SHADOW);
+  delegate->SetShowTitle(false);
+  delegate->SetShowCloseButton(false);
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->set_margins(gfx::Insets());
+  // L'aperçu tient dans l'écran (zone de travail, sans la barre des tâches).
+  const gfx::Rect area =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view->GetWidget()->GetNativeView())
+          .work_area();
+  auto web_view = std::make_unique<views::WebView>(browser->GetProfile());
+  web_view->SetPreferredSize(
+      gfx::Size(480, std::clamp(area.height() - 48, 240, 640)));
+  views::WebView* raw = web_view.get();
+  delegate->SetContentsView(std::move(web_view));
+  Preview& preview = CurrentPreview();
+  preview.delegate = std::move(delegate);
+  // Fermée par Chromium (Échap, perte du focus) : détruite juste après.
+  preview.widget = views::BubbleDialogDelegate::CreateBubble(
+      preview.delegate.get(), base::BindOnce([](views::Widget::ClosedReason) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&ClosePreview));
+      }));
+  raw->LoadInitialURL(url);
+  // Placée à côté du favori, puis ramenée dans l'écran s'il dépasse en bas.
+  gfx::Rect bounds = preview.widget->GetWindowBoundsInScreen();
+  bounds.AdjustToFit(area);
+  preview.widget->SetBounds(bounds);
+  preview.widget->ShowInactive();
+  return true;
+}
