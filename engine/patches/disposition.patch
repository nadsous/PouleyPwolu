+ExtensionFunction::ResponseAction PouleyPrivateShowPreviewFunction::Run() {
+  auto params = api::pouley_private::ShowPreview::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  BrowserWindowInterface* browser = BrowserFor(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  const GURL url(params->url);
+  // Seulement des pages web : l'aperçu ne doit pas ouvrir de page interne.
+  if (!params->url.empty() && !url.SchemeIsHTTPOrHTTPS()) {
+    return RespondNow(Error("Aperçu réservé aux pages web."));
+  }
+  const auto& a = params->anchor;
+  return RespondNow(WithArguments(pouley::ShowPreview(
+      browser, url, gfx::Rect(a.left, a.top, a.width, a.height))));
+}
