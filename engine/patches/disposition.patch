+std::vector<ExtensionBadge> GetExtensionBadges(BrowserWindowInterface* browser) {
+  std::vector<ExtensionBadge> badges;
+  content::WebContents* contents =
+      browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  if (!contents) {
+    return badges;
+  }
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  auto* manager = extensions::ExtensionActionManager::Get(browser->GetProfile());
+  for (const auto& extension :
+       extensions::ExtensionRegistry::Get(browser->GetProfile())
+           ->enabled_extensions()) {
+    extensions::ExtensionAction* action =
+        manager->GetExtensionAction(*extension);
+    if (!action) {
+      continue;
+    }
+    std::string text = action->GetDisplayBadgeText(tab_id);
+    if (text.empty()) {
+      continue;
+    }
+    badges.push_back(
+        {extension->id(), std::move(text), action->GetBadgeBackgroundColor(tab_id)});
+  }
+  return badges;
+}
