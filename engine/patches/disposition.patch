+namespace {
+
+// Processus PowerShell gardé ouvert (comme dans la version Electron) : une commande
+// par ligne sur son entrée, une réponse JSON par ligne sur sa sortie.
+class SystemMediaProcess {
+ public:
+  static SystemMediaProcess& Get() {
+    static base::NoDestructor<SystemMediaProcess> instance;
+    return *instance;
+  }
+
+  std::string Run(const base::FilePath& script, const std::string& command) {
+    base::AutoLock lock(lock_);
+    if (!EnsureStarted(script)) {
+      return std::string();
+    }
+    const std::string line = command + "\n";
+    DWORD written = 0;
+    if (!::WriteFile(stdin_write_.get(), line.data(),
+                     static_cast<DWORD>(line.size()), &written, nullptr)) {
+      Stop();
+      return std::string();
+    }
+    std::string out;
+    char c = 0;
+    DWORD read = 0;
+    while (true) {
+      if (!::ReadFile(stdout_read_.get(), &c, 1, &read, nullptr) || !read) {
+        Stop();
+        return std::string();
+      }
+      if (c == '\n') {
+        break;
+      }
+      if (c != '\r') {
+        out.push_back(c);
+      }
+      if (out.size() > 4 * 1024 * 1024) {
+        Stop();
+        return std::string();
+      }
+    }
+    return out;
+  }
+
+ private:
+  bool EnsureStarted(const base::FilePath& script) {
+    if (process_.IsValid()) {
+      return true;
+    }
+    SECURITY_ATTRIBUTES sa = {sizeof(sa), nullptr, TRUE};
+    HANDLE in_read = nullptr, in_write = nullptr;
+    HANDLE out_read = nullptr, out_write = nullptr;
+    if (!::CreatePipe(&in_read, &in_write, &sa, 0)) {
+      return false;
+    }
+    if (!::CreatePipe(&out_read, &out_write, &sa, 0)) {
+      ::CloseHandle(in_read);
+      ::CloseHandle(in_write);
+      return false;
+    }
+    ::SetHandleInformation(in_write, HANDLE_FLAG_INHERIT, 0);
+    ::SetHandleInformation(out_read, HANDLE_FLAG_INHERIT, 0);
+    base::win::ScopedHandle nul(::CreateFileW(
+        L"NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+        OPEN_EXISTING, 0, nullptr));
+    base::CommandLine cmd(base::FilePath(L"powershell.exe"));
+    cmd.AppendArg("-NoProfile");
+    cmd.AppendArg("-NonInteractive");
+    cmd.AppendArg("-ExecutionPolicy");
+    cmd.AppendArg("Bypass");
+    cmd.AppendArg("-File");
+    cmd.AppendArgPath(script);
+    cmd.AppendArg("pouley");
+    base::LaunchOptions options;
+    options.start_hidden = true;
+    options.stdin_handle = in_read;
+    options.stdout_handle = out_write;
+    options.stderr_handle = nul.get();
+    options.handles_to_inherit = {in_read, out_write, nul.get()};
+    process_ = base::LaunchProcess(cmd, options);
+    ::CloseHandle(in_read);
+    ::CloseHandle(out_write);
+    stdin_write_.Set(in_write);
+    stdout_read_.Set(out_read);
+    if (!process_.IsValid()) {
+      stdin_write_.Close();
+      stdout_read_.Close();
+      return false;
+    }
+    return true;
+  }
+
+  void Stop() {
+    if (process_.IsValid()) {
+      process_.Terminate(0, false);
+      process_.Close();
+    }
+    stdin_write_.Close();
+    stdout_read_.Close();
+  }
+
+  base::Lock lock_;
+  base::Process process_;
+  base::win::ScopedHandle stdin_write_;
+  base::win::ScopedHandle stdout_read_;
+};
+
+}  // namespace
+#endif
+
+std::string RunSystemMedia(const std::string& script_path,
+                           const std::string& command) {
+#if BUILDFLAG(IS_WIN)
+  if (command != "state" && command != "toggle" && command != "next" &&
+      command != "prev") {
+    return std::string();
+  }
+  return SystemMediaProcess::Get().Run(base::FilePath::FromUTF8Unsafe(script_path),
+                                       command);
+#else
+  return std::string();
+#endif
+}
