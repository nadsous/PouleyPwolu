+bool SetSidebarLayout(BrowserWindowInterface* browser, bool right, int width) {
+  if (!browser) {
+    return false;
+  }
+  PrefService* pref_service = browser->GetProfile()->GetPrefs();
+  // Le panneau latéral suit ce réglage dans toutes les fenêtres.
+  if (pref_service->GetBoolean(prefs::kSidePanelHorizontalAlignment) !=
+      right) {
+    pref_service->SetBoolean(prefs::kSidePanelHorizontalAlignment, right);
+  }
+  if (width <= 0) {
+    return true;
+  }
+  // Largeur gardée comme si la barre avait été glissée à la main.
+  if (SidePanelUI* ui = SidePanelUI::From(browser)) {
+    if (std::optional<SidePanelEntryId> entry = ui->GetCurrentEntryId()) {
+      ScopedDictPrefUpdate update(pref_service, prefs::kSidePanelIdToWidth);
+      update->Set(SidePanelEntryIdToString(entry.value()), width);
+    }
+  }
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [width](BrowserWindowInterface* other) {
+        BrowserView* view = BrowserView::GetBrowserViewForBrowser(other);
+        if (view && view->side_panel()) {
+          view->side_panel()->SetPanelWidth(width);
+          view->InvalidateLayout();
+        }
+        return true;
+      });
+  return true;
+}
+
+bool SetTopBar(BrowserWindowInterface* browser,
+               bool show,
+               int height,
+               const std::string& path) {
+  MultiContentsView* mcv = MultiContentsOf(browser);
+  if (!mcv) {
+    return false;
+  }
+  if (!show) {
+    mcv->SetPouleyTopBar(nullptr, 0);
+    return true;
+  }
+  if (mcv->pouley_top_bar()) {
+    mcv->SetPouleyTopBar(nullptr, 0);
+  }
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(browser->GetProfile())
+          ->enabled_extensions()
+          .GetByID(kPouleyExtensionId);
+  if (!extension) {
+    return false;
+  }
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreateSidePanelHost(
+          *extension,
+          extension->ResolveExtensionURL(path.empty() ? "sidebar/index.html?top=1"
+                                                      : path),
+          browser, /*tab_interface=*/nullptr);
+  if (!host) {
+    return false;
+  }
+  mcv->SetPouleyTopBar(
+      std::make_unique<PouleyTopBarView>(browser->GetProfile(), std::move(host)),
+      std::max(32, height));
+  return true;
+}
+
+bool SetWindowOpacity(BrowserWindowInterface* browser, double opacity) {
+#if BUILDFLAG(IS_WIN)
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || !browser_view->GetWidget()) {
+    return false;
+  }
+  // Comme Electron (BrowserWindow.setOpacity) : fenêtre « layered », alpha global.
+  HWND hwnd = views::HWNDForWidget(browser_view->GetWidget());
+  const double value = std::clamp(opacity, 0.25, 1.0);
+  LONG ex_style = ::GetWindowLong(hwnd, GWL_EXSTYLE);
+  if (!(ex_style & WS_EX_LAYERED)) {
+    ::SetWindowLong(hwnd, GWL_EXSTYLE, ex_style | WS_EX_LAYERED);
+  }
+  ::SetLayeredWindowAttributes(hwnd, 0, static_cast<BYTE>(value * 255),
+                               LWA_ALPHA);
+  return true;
+#else
+  return false;
+#endif
+}
