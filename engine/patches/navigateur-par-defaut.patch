       WithArguments(pouley::SetAlwaysOnTop(browser, params->on_top)));
 }
 
+namespace {
+
+std::string DefaultBrowserState(int state) {
+  switch (state) {
+    case shell_integration::IS_DEFAULT:
+      return "default";
+    case shell_integration::NOT_DEFAULT:
+    case shell_integration::OTHER_MODE_IS_DEFAULT:
+      return "available";
+    default:
+      return "unknown";
+  }
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction
+PouleyPrivateGetDefaultBrowserFunction::Run() {
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartCheckIsDefault(base::BindOnce(
+          [](scoped_refptr<PouleyPrivateGetDefaultBrowserFunction> self,
+             shell_integration::DefaultWebClientState state) {
+            self->OnState(state);
+          },
+          base::WrapRefCounted(this)));
+  return RespondLater();
+}
+
+void PouleyPrivateGetDefaultBrowserFunction::OnState(int state) {
+  Respond(WithArguments(DefaultBrowserState(state)));
+}
+
+ExtensionFunction::ResponseAction
+PouleyPrivateSetDefaultBrowserFunction::Run() {
+#if BUILDFLAG(IS_WIN)
+  // Windows 10 et 11 ne laissent aucune application se choisir : on ouvre la
+  // page de PouleyPwolu dans « Applications par défaut » (après l'avoir inscrit
+  // auprès de Windows, au cas où l'installation ne l'aurait pas fait).
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce([] {
+        base::win::ScopedCOMInitializer com;
+        base::FilePath exe;
+        if (!base::PathService::Get(base::FILE_EXE, &exe)) {
+          return;
+        }
+        ShellUtil::RegisterChromeBrowser(exe, std::wstring(),
+                                         /*elevate_if_not_admin=*/false);
+        const std::wstring url = base::StrCat(
+            {L"ms-settings:defaultapps?registeredAppUser=",
+             install_static::GetBaseAppName(),
+             ShellUtil::GetCurrentInstallationSuffix(exe)});
+        ::ShellExecuteW(nullptr, L"open", url.c_str(), nullptr, nullptr,
+                        SW_SHOWNORMAL);
+      }),
+      base::BindOnce(&PouleyPrivateSetDefaultBrowserFunction::OnState, this,
+                     static_cast<int>(shell_integration::NOT_DEFAULT)));
+  return RespondLater();
+#else
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartSetAsDefault(base::BindOnce(
+          [](scoped_refptr<PouleyPrivateSetDefaultBrowserFunction> self,
+             shell_integration::DefaultWebClientState state) {
+            self->OnState(state);
+          },
+          base::WrapRefCounted(this)));
+  return RespondLater();
+#endif
+}
+
+void PouleyPrivateSetDefaultBrowserFunction::OnState(int state) {
+  Respond(WithArguments(DefaultBrowserState(state)));
+}
+
 }  // namespace extensions
