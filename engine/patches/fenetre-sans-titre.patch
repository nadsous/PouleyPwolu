new file mode 100644
index 0000000000..1a5f356f9f
--- /dev/null
+++ b/chrome/browser/extensions/pouley_drag_region.cc
@@ -0,0 +1,34 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/pouley_drag_region.h"
+
+#include "third_party/blink/public/mojom/page/draggable_region.mojom.h"
+#include "ui/gfx/geometry/point.h"
+
+namespace pouley {
+
+DragRegion::DragRegion(content::WebContents* contents)
+    : content::WebContentsUserData<DragRegion>(*contents) {}
+
+DragRegion::~DragRegion() = default;
+
+void DragRegion::Update(
+    const std::vector<blink::mojom::DraggableRegionPtr>& regions) {
+  region_.setEmpty();
+  for (const blink::mojom::DraggableRegionPtr& region : regions) {
+    region_.op(
+        SkIRect::MakeXYWH(region->bounds.x(), region->bounds.y(),
+                          region->bounds.width(), region->bounds.height()),
+        region->draggable ? SkRegion::kUnion_Op : SkRegion::kDifference_Op);
+  }
+}
+
+bool DragRegion::Contains(const gfx::Point& point) const {
+  return region_.contains(point.x(), point.y());
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DragRegion);
+
+}  // namespace pouley
