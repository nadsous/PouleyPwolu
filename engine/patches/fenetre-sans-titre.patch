+    if (frame_component == HTCLIENT && IsPouleyWindow(GetBrowserView())) {
+      gfx::Point in_widget = point;
+      views::View::ConvertPointToWidget(this, &in_widget);
+      views::View* target =
+          GetWidget()->GetRootView()->GetEventHandlerForPoint(in_widget);
+      for (views::View* v = target; v; v = v->parent()) {
+        auto* web_view = views::AsViewClass<views::WebView>(v);
+        if (!web_view) {
+          continue;
+        }
+        auto* drag = web_view->web_contents()
+                         ? pouley::DragRegion::FromWebContents(
+                               web_view->web_contents())
+                         : nullptr;
+        if (drag) {
+          gfx::Point in_view = in_widget;
+          views::View::ConvertPointFromWidget(web_view, &in_view);
+          if (drag->Contains(in_view)) {
+            return HTCAPTION;
+          }
+        }
+        break;
+      }
+    }
