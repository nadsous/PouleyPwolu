@@ -0,0 +1,45 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_POULEY_DRAG_REGION_H_
+#define CHROME_BROWSER_EXTENSIONS_POULEY_DRAG_REGION_H_
+
+#include <vector>
+
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/mojom/page/draggable_region.mojom-forward.h"
+#include "third_party/skia/include/core/SkRegion.h"
+
+namespace gfx {
+class Point;
+}
+
+namespace pouley {
+
+// Identifiant de l'extension intégrée PouleyPwolu (sa barre latérale).
+inline constexpr char kPouleyExtensionId[] = "dhjkdmdnmjmglljdpbfclbpgphfnapck";
+
+// Zones « app-region: drag » de la barre PouleyPwolu : la fenêtre se déplace en
+// les faisant glisser, comme la barre de titre qu'elles remplacent.
+class DragRegion : public content::WebContentsUserData<DragRegion> {
+ public:
+  ~DragRegion() override;
+
+  void Update(const std::vector<blink::mojom::DraggableRegionPtr>& regions);
+
+  // `point` est en coordonnées de la page de la barre.
+  bool Contains(const gfx::Point& point) const;
+
+ private:
+  explicit DragRegion(content::WebContents* contents);
+  friend class content::WebContentsUserData<DragRegion>;
+
+  SkRegion region_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace pouley
+
+#endif  // CHROME_BROWSER_EXTENSIONS_POULEY_DRAG_REGION_H_
