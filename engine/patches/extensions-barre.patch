+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_POULEY_DOCK_H_
+#define CHROME_BROWSER_EXTENSIONS_POULEY_DOCK_H_
+
+#include <string>
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace extensions {
+class Extension;
+}
+
+namespace gfx {
+class Rect;
+}
+
+// PouleyPwolu : la barre PouleyPwolu occupe le panneau latéral de Chromium. Les
+// extensions s'affichent donc ailleurs :
+// - leur fenêtre (popup) s'ouvre à côté de leur bouton dans la barre ;
+// - leur panneau latéral (Claude…) s'ouvre à droite de la page, qui rétrécit.
+// Implémenté dans chrome/browser/ui/views/extensions/pouley_dock.cc.
+namespace pouley {
+
+// Ouvre le panneau de `extension` (adresse `url`) à droite de la page.
+bool OpenExtensionDock(BrowserWindowInterface* browser,
+                       const extensions::Extension& extension,
+                       const GURL& url);
+
+// Ferme le panneau ouvert à droite de la page. `extension_id` vide : quel qu'il soit.
+bool CloseExtensionDock(BrowserWindowInterface* browser,
+                        const std::string& extension_id);
+
+// Identifiant de l'extension dont le panneau est ouvert, ou chaîne vide.
+std::string GetExtensionDock(BrowserWindowInterface* browser);
+
+// Clic sur le bouton d'une extension dans la barre PouleyPwolu : comme un clic sur
+// son bouton dans la barre d'outils de Chrome. `anchor` : position du bouton dans
+// la barre. Renvoie "popup", "panel", "closed", "action" ou "none".
+std::string RunExtensionAction(BrowserWindowInterface* browser,
+                               const extensions::Extension& extension,
+                               const gfx::Rect& anchor);
+
+// Fenêtre toujours au premier plan (onglet flottant).
+bool SetAlwaysOnTop(BrowserWindowInterface* browser, bool on_top);
+
+}  // namespace pouley
+
+#endif  // CHROME_BROWSER_EXTENSIONS_POULEY_DOCK_H_
