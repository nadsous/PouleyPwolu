+
+namespace extensions {
+
+namespace {
+
+BrowserWindowInterface* BrowserFor(ExtensionFunction* function,
+                                   int window_id,
+                                   std::string* error) {
+  WindowController* controller = ExtensionTabUtil::GetControllerFromWindowID(
+      ChromeExtensionFunctionDetails(function), window_id, error);
+  return controller ? controller->GetBrowserWindowInterface() : nullptr;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction
+PouleyPrivateRunExtensionActionFunction::Run() {
+  auto params = api::pouley_private::RunExtensionAction::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  const auto& o = params->options;
+  std::string error;
+  BrowserWindowInterface* browser =
+      BrowserFor(this, o.window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  const Extension* target =
+      ExtensionRegistry::Get(browser_context())
+          ->enabled_extensions()
+          .GetByID(o.extension_id);
+  if (!target) {
+    return RespondNow(Error("Extension introuvable ou désactivée."));
+  }
+  const gfx::Rect anchor(o.left, o.top, o.width, o.height);
+  return RespondNow(
+      WithArguments(pouley::RunExtensionAction(browser, *target, anchor)));
+}
+
+ExtensionFunction::ResponseAction
+PouleyPrivateCloseExtensionPanelFunction::Run() {
+  auto params =
+      api::pouley_private::CloseExtensionPanel::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  BrowserWindowInterface* browser = BrowserFor(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(
+      WithArguments(pouley::CloseExtensionDock(browser, std::string())));
+}
+
+ExtensionFunction::ResponseAction
+PouleyPrivateGetExtensionPanelFunction::Run() {
+  auto params = api::pouley_private::GetExtensionPanel::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  BrowserWindowInterface* browser = BrowserFor(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(WithArguments(pouley::GetExtensionDock(browser)));
+}
+
+ExtensionFunction::ResponseAction
+PouleyPrivateGetMigrationStateFunction::Run() {
+#if BUILDFLAG(IS_WIN)
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] {
+        return pouley_migration::ReadPendingState().value_or(std::string());
+      }),
+      base::BindOnce(&PouleyPrivateGetMigrationStateFunction::OnState, this));
+  return RespondLater();
+#else
+  return RespondNow(WithArguments(std::string()));
+#endif
+}
+
+void PouleyPrivateGetMigrationStateFunction::OnState(std::string state) {
+  Respond(WithArguments(std::move(state)));
+}
+
+ExtensionFunction::ResponseAction
+PouleyPrivateMarkMigrationImportedFunction::Run() {
+#if BUILDFLAG(IS_WIN)
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&pouley_migration::MarkStateImported));
+#endif
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction PouleyPrivateSetAlwaysOnTopFunction::Run() {
+  auto params = api::pouley_private::SetAlwaysOnTop::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::string error;
+  BrowserWindowInterface* browser = BrowserFor(this, params->window_id, &error);
+  if (!browser) {
+    return RespondNow(Error(std::move(error)));
+  }
+  return RespondNow(
+      WithArguments(pouley::SetAlwaysOnTop(browser, params->on_top)));
+}
+
+}  // namespace extensions
