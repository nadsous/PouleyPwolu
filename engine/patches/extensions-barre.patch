+BrowserWindowInterface* PouleyBrowserFor(ExtensionFunction* function,
+                                         std::optional<int> window_id,
+                                         std::optional<int> tab_id,
+                                         bool include_incognito) {
+  std::string error;
+  WindowController* controller = nullptr;
