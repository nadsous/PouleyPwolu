index 0000000000..5e4f1f5e78
--- /dev/null
+++ b/chrome/browser/ui/views/extensions/pouley_dock.cc
@@ -0,0 +1,245 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/pouley_dock.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/extensions/api/side_panel/side_panel_service.h"
+#include "chrome/browser/extensions/extension_action_runner.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/extensions/extension_view_host_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/extensions/extension_popup.h"
+#include "chrome/browser/ui/views/extensions/extension_view_views.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "chrome/browser/ui/views/side_panel/side_panel.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/common/extension.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/bubble/bubble_anchor.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/controls/native/native_view_host.h"
+#include "ui/views/view.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+namespace pouley {
+
+namespace {
+
+// Point d'accroche (invisible) des fenêtres d'extensions dans le panneau latéral.
+constexpr int kPouleyAnchorViewId = 0x504f5557;
+constexpr float kDockRadius = 10.f;
+
+// Le panneau d'une extension à droite de la page : il garde l'hôte de la page de
+// l'extension en vie tant qu'il est affiché.
+class PouleyDockView : public views::View {
+  METADATA_HEADER(PouleyDockView, views::View)
+
+ public:
+  PouleyDockView(Profile* profile,
+                 std::unique_ptr<extensions::ExtensionViewHost> host,
+                 std::string extension_id)
+      : host_(std::move(host)), extension_id_(std::move(extension_id)) {
+    SetUseDefaultFillLayout(true);
+    auto view = std::make_unique<ExtensionViewViews>(profile, host_.get());
+    view->SetVisible(true);
+    extension_view_ = AddChildView(std::move(view));
+    // window.close() dans le panneau : il se ferme (après le retour de l'hôte).
+    host_->SetCloseHandler(base::BindOnce(
+        [](base::WeakPtr<PouleyDockView> self, extensions::ExtensionHost*) {
+          base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, base::BindOnce(&PouleyDockView::CloseSelf, self));
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+  PouleyDockView(const PouleyDockView&) = delete;
+  PouleyDockView& operator=(const PouleyDockView&) = delete;
+  ~PouleyDockView() override {
+    // La vue de l'extension utilise l'hôte : elle disparaît avant lui.
+    extension_view_ = nullptr;
+    RemoveAllChildViews();
+  }
+
+  const std::string& extension_id() const { return extension_id_; }
+
+  // views::View:
+  void AddedToWidget() override {
+    if (extension_view_) {
+      extension_view_->holder()->SetNativeViewCornerRadii(
+          gfx::RoundedCornersF(kDockRadius));
+    }
+  }
+
+ private:
+  void CloseSelf() {
+    if (auto* mcv = static_cast<MultiContentsView*>(parent())) {
+      mcv->SetPouleyDock(nullptr);
+    }
+  }
+
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  raw_ptr<ExtensionViewViews> extension_view_ = nullptr;
+  const std::string extension_id_;
+  base::WeakPtrFactory<PouleyDockView> weak_factory_{this};
+};
+
+BEGIN_METADATA(PouleyDockView)
+END_METADATA
+
+MultiContentsView* MultiContentsOf(BrowserWindowInterface* browser) {
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  return browser_view ? browser_view->multi_contents_view() : nullptr;
+}
+
+PouleyDockView* DockOf(BrowserWindowInterface* browser) {
+  MultiContentsView* mcv = MultiContentsOf(browser);
+  return mcv ? static_cast<PouleyDockView*>(mcv->pouley_dock()) : nullptr;
+}
+
+// Accroche invisible posée sur le bouton de l'extension, dans le panneau latéral.
+views::View* AnchorFor(BrowserView* browser_view, const gfx::Rect& rect) {
+  SidePanel* side_panel = browser_view->side_panel();
+  views::View* host = side_panel && side_panel->GetVisible()
+                          ? static_cast<views::View*>(side_panel)
+                          : static_cast<views::View*>(browser_view);
+  views::View* anchor = host->GetViewByID(kPouleyAnchorViewId);
+  if (!anchor || anchor->parent() != host) {
+    auto view = std::make_unique<views::View>();
+    view->SetID(kPouleyAnchorViewId);
+    view->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    view->SetCanProcessEventsWithinSubtree(false);
+    anchor = host->AddChildView(std::move(view));
+  }
+  gfx::Rect bounds = rect;
+  bounds.set_width(std::max(1, bounds.width()));
+  bounds.set_height(std::max(1, bounds.height()));
+  anchor->SetBoundsRect(bounds);
+  return anchor;
+}
+
+}  // namespace
+
+bool OpenExtensionDock(BrowserWindowInterface* browser,
+                       const extensions::Extension& extension,
+                       const GURL& url) {
+  MultiContentsView* mcv = MultiContentsOf(browser);
+  if (!mcv || !url.is_valid()) {
+    return false;
+  }
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreateSidePanelHost(
+          extension, url, browser, /*tab_interface=*/nullptr);
+  if (!host) {
+    return false;
+  }
+  mcv->SetPouleyDock(std::make_unique<PouleyDockView>(
+      browser->GetProfile(), std::move(host), extension.id()));
+  return true;
+}
+
+bool CloseExtensionDock(BrowserWindowInterface* browser,
+                        const std::string& extension_id) {
+  PouleyDockView* dock = DockOf(browser);
+  if (!dock || (!extension_id.empty() && dock->extension_id() != extension_id)) {
+    return false;
+  }
+  MultiContentsOf(browser)->SetPouleyDock(nullptr);
+  return true;
+}
+
+std::string GetExtensionDock(BrowserWindowInterface* browser) {
+  PouleyDockView* dock = DockOf(browser);
+  return dock ? dock->extension_id() : std::string();
+}
+
+std::string RunExtensionAction(BrowserWindowInterface* browser,
+                               const extensions::Extension& extension,
+                               const gfx::Rect& anchor) {
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  content::WebContents* contents =
+      browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  if (!browser_view || !contents) {
+    return "none";
+  }
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!runner) {
+    return "none";
+  }
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  switch (runner->RunAction(&extension, /*grant_tab_permissions=*/true)) {
+    case extensions::ExtensionAction::ShowAction::kToggleSidePanel: {
+      if (CloseExtensionDock(browser, extension.id())) {
+        return "closed";
+      }
+      auto* service = extensions::SidePanelService::Get(browser->GetProfile());
+      if (!service) {
+        return "none";
+      }
+      auto options = service->GetOptions(extension, tab_id);
+      if (!options.path) {
+        return "none";
+      }
+      return OpenExtensionDock(browser, extension,
+                               extension.ResolveExtensionURL(*options.path))
+                 ? "panel"
+                 : "none";
+    }
+    case extensions::ExtensionAction::ShowAction::kShowPopup: {
+      extensions::ExtensionAction* action =
+          extensions::ExtensionActionManager::Get(browser->GetProfile())
+              ->GetExtensionAction(extension);
+      if (!action) {
+        return "none";
+      }
+      std::unique_ptr<extensions::ExtensionViewHost> host =
+          extensions::ExtensionViewHostFactory::CreatePopupHost(
+              extension, action->GetPopupUrl(tab_id), browser);
+      if (!host) {
+        return "none";
+      }
+      // La barre est à gauche : la fenêtre s'ouvre à droite du bouton.
+      ExtensionPopup::ShowPopup(
+          browser, std::move(host),
+          views::BubbleAnchor(AnchorFor(browser_view, anchor)),
+          views::BubbleBorder::LEFT_TOP, PopupShowAction::kShow,
+          base::DoNothing());
+      return "popup";
+    }
+    case extensions::ExtensionAction::ShowAction::kNone:
+      return "action";
+  }
+  return "none";
+}
+
+bool SetAlwaysOnTop(BrowserWindowInterface* browser, bool on_top) {
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || !browser_view->GetWidget()) {
+    return false;
+  }
+  browser_view->GetWidget()->SetZOrderLevel(
+      on_top ? ui::ZOrderLevel::kFloatingWindow : ui::ZOrderLevel::kNormal);
+  return true;
+}
+
+}  // namespace pouley
