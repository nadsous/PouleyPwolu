@@ -0,0 +1,25 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PASSWORD_MANAGER_POULEY_MIGRATION_H_
+#define CHROME_BROWSER_PASSWORD_MANAGER_POULEY_MIGRATION_H_
+
+#include <optional>
+#include <string>
+
+// Données laissées par PouleyPwolu 0.1.12 (Electron) dans
+// %LOCALAPPDATA%\PouleyPwolu\Migration au passage sur Chromium. Format décrit
+// dans docs/migration-electron.md du dépôt PouleyPwolu.
+namespace pouley_migration {
+
+// Mots de passe au format CSV de Chrome, déchiffrés, si une migration attend
+// d'être importée. Bloquant (lecture de fichiers, DPAPI) : hors du thread UI.
+std::optional<std::string> ReadPendingPasswords();
+
+// Efface le fichier des mots de passe une fois importés. Bloquant.
+void MarkPasswordsImported();
+
+}  // namespace pouley_migration
+
+#endif  // CHROME_BROWSER_PASSWORD_MANAGER_POULEY_MIGRATION_H_
