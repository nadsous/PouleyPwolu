diff --git a/chrome/browser/password_manager/pouley_migration.cc b/chrome/browser/password_manager/pouley_migration.cc
new file mode 100644
index 0000000000..a5ea5f0e12
--- /dev/null
+++ b/chrome/browser/password_manager/pouley_migration.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 PouleyPwolu
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/password_manager/pouley_migration.h"
+
+#include <windows.h>
+
+#include <dpapi.h>
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/values.h"
+#include "crypto/aead.h"
+
+namespace pouley_migration {
+
+namespace {
+
+constexpr char kEntropy[] = "pouley-migration";
+constexpr char kPasswordsAad[] = "pouley-migration-mdp";
+constexpr size_t kMagic = 4, kIv = 12, kTag = 16;
+
+base::FilePath MigrationDir() {
+  base::FilePath local;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local)) {
+    return base::FilePath();
+  }
+  return local.Append(L"PouleyPwolu").Append(L"Migration");
+}
+
+// Clé de 32 octets protégée par DPAPI (portée utilisateur) par la 0.1.12.
+std::optional<std::vector<uint8_t>> UnprotectKey(const std::string& blob) {
+  DATA_BLOB in{static_cast<DWORD>(blob.size()),
+               reinterpret_cast<BYTE*>(const_cast<char*>(blob.data()))};
+  DATA_BLOB entropy{static_cast<DWORD>(sizeof(kEntropy) - 1),
+                    reinterpret_cast<BYTE*>(const_cast<char*>(kEntropy))};
+  DATA_BLOB out{};
+  if (!CryptUnprotectData(&in, nullptr, &entropy, nullptr, nullptr,
+                          CRYPTPROTECT_UI_FORBIDDEN, &out)) {
+    return std::nullopt;
+  }
+  // SAFETY: CryptUnprotectData renvoie un tampon de out.cbData octets.
+  std::vector<uint8_t> key(out.pbData, UNSAFE_BUFFERS(out.pbData + out.cbData));
+  SecureZeroMemory(out.pbData, out.cbData);
+  LocalFree(out.pbData);
+  if (key.size() != 32) {
+    return std::nullopt;
+  }
+  return key;
+}
+
+// « PLY1 » | IV (12) | tag GCM (16) | données chiffrées, AES-256-GCM.
+std::optional<std::string> Open(const std::vector<uint8_t>& key,
+                                const std::string& file,
+                                std::string_view aad) {
+  if (file.size() < kMagic + kIv + kTag || file.compare(0, kMagic, "PLY1")) {
+    return std::nullopt;
+  }
+  auto bytes = base::as_byte_span(file);
+  auto iv = bytes.subspan(kMagic, kIv);
+  auto tag = bytes.subspan(kMagic + kIv, kTag);
+  auto data = bytes.subspan(kMagic + kIv + kTag);
+  // BoringSSL attend les données suivies du tag.
+  std::vector<uint8_t> sealed(data.begin(), data.end());
+  sealed.insert(sealed.end(), tag.begin(), tag.end());
+  auto plain = crypto::aead::Open(crypto::aead::AES_256_GCM, key, sealed, iv,
+                                  base::as_byte_span(aad));
+  if (!plain) {
+    return std::nullopt;
+  }
+  return std::string(plain->begin(), plain->end());
+}
+
+}  // namespace
+
+std::optional<std::string> ReadPendingPasswords() {
+  base::FilePath dir = MigrationDir();
+  if (dir.empty()) {
+    return std::nullopt;
+  }
+  std::string manifest_text;
+  if (!base::ReadFileToString(dir.Append(L"manifest.json"), &manifest_text)) {
+    return std::nullopt;  // Pas de migration (cas normal).
+  }
+  std::optional<base::DictValue> manifest =
+      base::JSONReader::ReadDict(manifest_text, base::JSON_PARSE_RFC);
+  const std::string* name =
+      manifest ? manifest->FindString("motsDePasse") : nullptr;
+  if (!manifest || manifest->FindInt("format") != 1 || !name) {
+    return std::nullopt;
+  }
+  std::string key_blob, sealed;
+  if (!base::ReadFileToString(dir.Append(L"cle.dpapi"), &key_blob) ||
+      !base::ReadFileToString(dir.AppendASCII(*name), &sealed)) {
+    return std::nullopt;  // Déjà importés.
+  }
+  std::optional<std::vector<uint8_t>> key = UnprotectKey(key_blob);
+  if (!key) {
+    LOG(ERROR) << "PouleyPwolu : clé de migration illisible.";
+    return std::nullopt;
+  }
+  std::optional<std::string> csv = Open(*key, sealed, kPasswordsAad);
+  std::fill(key->begin(), key->end(), 0);
+  if (!csv) {
+    LOG(ERROR) << "PouleyPwolu : mots de passe de migration illisibles.";
+  }
+  return csv;
+}
+
+void MarkPasswordsImported() {
+  base::FilePath dir = MigrationDir();
+  if (!dir.empty()) {
+    base::DeleteFile(dir.Append(L"mots-de-passe.bin"));
+  }
+}
+
+}  // namespace pouley_migration
