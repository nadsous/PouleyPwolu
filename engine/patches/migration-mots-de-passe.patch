 }
 
+void StartupPasswordsImporter::OnPouleyPasswordsRead(
+    std::optional<std::string> csv) {
+  if (!csv) {
+    return;
+  }
+  pouley_migration_ = true;
+  // Le CSV reste en mémoire : il n'est jamais écrit en clair sur le disque.
+  password_importer_->Import(
+      std::move(*csv), password_manager::PasswordForm::Store::kProfileStore,
+      base::BindOnce(&StartupPasswordsImporter::OnImportFinished,
+                     base::Unretained(this)));
+}
+
 void StartupPasswordsImporter::OnImportFinished(
     const password_manager::ImportResults& results) {
+#if BUILDFLAG(IS_WIN)
+  if (pouley_migration_ &&
+      results.status == password_manager::ImportResults::Status::SUCCESS) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&pouley_migration::MarkPasswordsImported));
+  }
+#endif
   VLOG(1) << "Password import finished with status: "
           << static_cast<int>(results.status);
 
