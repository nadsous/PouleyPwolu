{
  "manifest_version": 3,
  "name": "PouleyPwolu",
  "version": "0.3.1",
  "description": "Poulaillers, bouclier, inspecteur, détecteur d'IA, stylo, plumes et tenders.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pouleypwolu@nads.site",
      "strict_min_version": "160.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "PouleyPwolu",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    },
    "open_at_install": true
  },
  "action": {
    "default_title": "PouleyPwolu"
  },
  "chrome_url_overrides": {
    "newtab": "pages/newtab.html"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "privacy",
    "scripting",
    "webNavigation",
    "alarms",
    "contextMenus",
    "idle",
    "clipboardWrite",
    "management",
    "declarativeNetRequestFeedback",
    "downloads",
    "webRequest",
    "cookies",
    "browsingData",
    "downloads.open",
    "history",
    "webRequestBlocking",
    "menus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/masquer-appliquer.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/probes-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/probes.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/json-view.js",
        "content/json-viewer.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/keys.js",
        "content/raccourcis.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/index.html",
        "sidebar/Onest-Regular.ttf",
        "sidebar/Onest-SemiBold.ttf",
        "sidebar/JetBrainsMono-Regular.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture d’écran de la zone visible"
    },
    "capture-zone": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Capture d’écran d’une zone"
    },
    "stylo": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Écrire sur la page (stylo)"
    },
    "inspecteur": {
      "suggested_key": {
        "default": "Ctrl+I",
        "mac": "Command+I"
      },
      "description": "Inspecter le site"
    },
    "masquer": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Masquer des éléments de la page"
    }
  },
  "experiment_apis": {
    "pouleyPrivate": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/parent.js",
        "paths": [
          [
            "pouleyPrivate"
          ]
        ]
      }
    }
  }
}
