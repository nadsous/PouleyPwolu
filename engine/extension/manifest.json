{
  "manifest_version": 3,
  "name": "PouleyPwolu",
  "version": "0.2.0",
  "description": "Poulaillers, bouclier, inspecteur, détecteur d'IA, stylo, plumes et tenders.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar/index.html"
  },
  "action": {
    "default_title": "PouleyPwolu"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "privacy",
    "scripting",
    "webNavigation",
    "alarms",
    "contextMenus",
    "favicon",
    "idle",
    "clipboardWrite",
    "management",
    "declarativeNetRequestFeedback",
    "downloads",
    "webRequest",
    "cookies",
    "system.memory",
    "browsingData",
    "contentSettings",
    "downloads.open",
    "pouleyPrivate",
    "processes",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/*"
      ],
      "js": [
        "content/cws.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/probes-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/probes.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/json-view.js",
        "content/json-viewer.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar/index.html",
        "sidebar/Onest-Regular.ttf",
        "sidebar/Onest-SemiBold.ttf",
        "sidebar/JetBrainsMono-Regular.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture d’écran de la zone visible"
    },
    "capture-zone": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Capture d’écran d’une zone"
    },
    "stylo": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Écrire sur la page (stylo)"
    },
    "inspecteur": {
      "suggested_key": {
        "default": "Ctrl+I",
        "mac": "Command+I"
      },
      "description": "Inspecter le site"
    }
  }
}
