{
  "manifest_version": 3,
  "name": "PouleyPwolu",
  "version": "1.0.0",
  "description": "Poulaillers, bouclier, inspecteur, détecteur d'IA, stylo, plumes et tenders.",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidebar/sidebar.html" },
  "action": { "default_title": "PouleyPwolu" },
  "permissions": ["sidePanel", "tabs", "tabGroups", "storage", "unlimitedStorage", "declarativeNetRequest", "privacy", "scripting", "webNavigation", "alarms", "contextMenus", "favicon"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
